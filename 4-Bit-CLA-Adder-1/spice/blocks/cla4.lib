* =====================================================================
* cla4.lib - 4-bit Carry Look-Ahead adder core (combinational)
*
*  Block 1  P/G     : gb=(ab)'  tb=(a+b)'  p=a^b (AOI21)  pb=(a^b)' (OAI21)
*  Block 2  CLA     : group terms (independent of c0)
*                     G10=g1+t1g0  T10=t1t0          (c2 = G10 + T10.c0)
*                     G20=g2+t2G10 T20=t2T10         (c3 = G20 + T20.c0)
*                     G30=G32+T32G10, T30=T32T10     (c4 = G30 + T30.c0)
*                     final:  ci' = AOI21(c0, T, G)  -> ONE gate from c0
*  Block 3  SUM     : s_i = p_i XOR c_i  (SUMCELL, c_i' is the late input)
*
*  Uses t = a+b (not a^b) inside the carry network: valid because when
*  a=b=1, g=1 already forces the carry.  Requires common.inc,
*  mos.lib, cells.lib, sumcell.inc.
*
*  Outputs: s0..s3, c4 and c4b (=c4', exported for Part-II carry gating)
* =====================================================================
.param SPG=1  SGRP=1  SCAR=1  SSUM=1  SC0=2

.subckt CLA4 a0 a1 a2 a3 b0 b1 b2 b3 c0 s0 s1 s2 s3 c4 c4b
* ---------------- Block 1 : propagate / generate --------------------
XGB0 a0 b0 gb0 NAND2 s={SPG}
XTB0 a0 b0 tb0 NOR2  s={SPG}
XP0  a0 b0 tb0 p0  AOI21 s={SPG}
XPB0 a0 b0 gb0 pb0 OAI21 s={SPG}

XGB1 a1 b1 gb1 NAND2 s={SPG}
XTB1 a1 b1 tb1 NOR2  s={SPG}
XP1  a1 b1 tb1 p1  AOI21 s={SPG}
XPB1 a1 b1 gb1 pb1 OAI21 s={SPG}

XGB2 a2 b2 gb2 NAND2 s={SPG}
XTB2 a2 b2 tb2 NOR2  s={SPG}
XP2  a2 b2 tb2 p2  AOI21 s={SPG}
XPB2 a2 b2 gb2 pb2 OAI21 s={SPG}

XGB3 a3 b3 gb3 NAND2 s={SPG}
XTB3 a3 b3 tb3 NOR2  s={SPG}
XP3  a3 b3 tb3 p3  AOI21 s={SPG}
XPB3 a3 b3 gb3 pb3 OAI21 s={SPG}

* ---------------- Block 2 : group generate / propagate --------------
XG0   gb0 G0 INV s={SGRP}
XT0   tb0 T0 INV s={SGRP}
XG10  tb1 gb0 gb1 G10 OAI21 s={SGRP}
XT10  tb1 tb0 T10 NOR2 s={SGRP}
XG2   gb2 g2 INV s={SGRP}
XT2   tb2 t2 INV s={SGRP}
XG20B t2 G10 g2 G20B AOI21 s={SGRP}
XG20  G20B G20 INV s={SGRP}
XT20B t2 T10 T20B NAND2 s={SGRP}
XT20  T20B T20 INV s={SGRP}
XG32  tb3 gb2 gb3 G32 OAI21 s={SGRP}
XT32  tb3 tb2 T32 NOR2 s={SGRP}
XG30B T32 G10 G32 G30B AOI21 s={SGRP}
XG30  G30B G30 INV s={SGRP}
XT30B T32 T10 T30B NAND2 s={SGRP}
XT30  T30B T30 INV s={SGRP}

* ---------------- Block 2 : final carries (c0 is the late input) ----
XC0B c0 c0b INV s={SC0}
XC1  c0 T0  G0  c1b AOI21 s={SCAR}
XC2  c0 T10 G10 c2b AOI21 s={SCAR}
XC3  c0 T20 G20 c3b AOI21 s={SCAR}
XC4  c0 T30 G30 c4b AOI21 s={SCAR}
XC4O c4b c4 INV s={SCAR}

* ---------------- Block 3 : sum ---------------------------------------
XS0 p0 pb0 c0b s0 SUMCELL s={SSUM}
XS1 p1 pb1 c1b s1 SUMCELL s={SSUM}
XS2 p2 pb2 c2b s2 SUMCELL s={SSUM}
XS3 p3 pb3 c3b s3 SUMCELL s={SSUM}
.ends CLA4
