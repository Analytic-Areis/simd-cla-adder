* E4 nor2 far-rail input FO6
.include ../../../../TSMC_180nm.txt
.options reltol=1e-4
VDD vdd gnd 1.8
Vin in0 gnd PULSE(0 1.8 1n 20p 20p 2n 4n)
.subckt gnor2 i0 i1 out vdd gnd
mn0 out i0 gnd gnd CMOSN W=9.0000e-07 L=1.8000e-07 AS=4.8600e-13 PS=2.8800e-06 AD=4.8600e-13 PD=2.8800e-06
mp0 out i0 x1 vdd CMOSP W=3.6000e-06 L=1.8000e-07 AS=9.7200e-13 PS=7.7400e-06 AD=1.9440e-12 PD=8.2800e-06
mn1 out i1 gnd gnd CMOSN W=9.0000e-07 L=1.8000e-07 AS=4.8600e-13 PS=2.8800e-06 AD=4.8600e-13 PD=2.8800e-06
mp1 x1 i1 vdd vdd CMOSP W=3.6000e-06 L=1.8000e-07 AS=1.9440e-12 PS=8.2800e-06 AD=9.7200e-13 PD=7.7400e-06
.ends
.subckt sh in out vdd gnd
mp out in vdd vdd CMOSP W=5.4000e-07 L=1.8000e-07 AS=2.9160e-13 PS=2.1600e-06 AD=2.9160e-13 PD=2.1600e-06
mn out in gnd gnd CMOSN W=2.7000e-07 L=1.8000e-07 AS=1.4580e-13 PS=1.6200e-06 AD=1.4580e-13 PD=1.6200e-06
.ends
.subckt dr in out vdd gnd
mp out in vdd vdd CMOSP W=7.3419e-07 L=1.8000e-07 AS=3.9646e-13 PS=2.5484e-06 AD=3.9646e-13 PD=2.5484e-06
mn out in gnd gnd CMOSN W=3.6710e-07 L=1.8000e-07 AS=1.9823e-13 PS=1.8142e-06 AD=1.9823e-13 PD=1.8142e-06
.ends
.subckt lo in out vdd gnd
mp out in vdd vdd CMOSP W=1.7621e-05 L=1.8000e-07 AS=9.5151e-12 PS=3.6321e-05 AD=9.5151e-12 PD=3.6321e-05
mn out in gnd gnd CMOSN W=8.8103e-06 L=1.8000e-07 AS=4.7576e-12 PS=1.8701e-05 AD=4.7576e-12 PD=1.8701e-05
.ends
.subckt ll in out vdd gnd
mp out in vdd vdd CMOSP W=7.0482e-05 L=1.8000e-07 AS=3.8061e-11 PS=1.4204e-04 AD=3.8061e-11 PD=1.4204e-04
mn out in gnd gnd CMOSN W=3.5241e-05 L=1.8000e-07 AS=1.9030e-11 PS=7.1562e-05 AD=1.9030e-11 PD=7.1562e-05
.ends
X0 in0 n1 vdd gnd sh
X1 n1 ndut vdd gnd dr
X2 gnd ndut nout vdd gnd gnor2
X3 nout n3 vdd gnd lo
X4 n3 n4 vdd gnd ll
.tran 0.5p 11n
.meas tran tphl TRIG v(ndut) VAL=0.9 RISE=2 TARG v(nout) VAL=0.9 FALL=2
.meas tran tplh TRIG v(ndut) VAL=0.9 FALL=2 TARG v(nout) VAL=0.9 RISE=2
.end
