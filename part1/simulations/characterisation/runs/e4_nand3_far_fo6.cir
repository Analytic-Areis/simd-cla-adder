* E4 nand3 far-rail input FO6
.include ../../../../TSMC_180nm.txt
.options reltol=1e-4
VDD vdd gnd 1.8
Vin in0 gnd PULSE(0 1.8 1n 20p 20p 2n 4n)
.subckt gnand3 i0 i1 i2 out vdd gnd
mp0 out i0 vdd vdd CMOSP W=1.8000e-06 L=1.8000e-07 AS=9.7200e-13 PS=4.6800e-06 AD=9.7200e-13 PD=4.6800e-06
mn0 out i0 x1 gnd CMOSN W=2.7000e-06 L=1.8000e-07 AS=7.2900e-13 PS=5.9400e-06 AD=1.4580e-12 PD=6.4800e-06
mp1 out i1 vdd vdd CMOSP W=1.8000e-06 L=1.8000e-07 AS=9.7200e-13 PS=4.6800e-06 AD=9.7200e-13 PD=4.6800e-06
mn1 x1 i1 x2 gnd CMOSN W=2.7000e-06 L=1.8000e-07 AS=7.2900e-13 PS=5.9400e-06 AD=7.2900e-13 PD=5.9400e-06
mp2 out i2 vdd vdd CMOSP W=1.8000e-06 L=1.8000e-07 AS=9.7200e-13 PS=4.6800e-06 AD=9.7200e-13 PD=4.6800e-06
mn2 x2 i2 gnd gnd CMOSN W=2.7000e-06 L=1.8000e-07 AS=1.4580e-12 PS=6.4800e-06 AD=7.2900e-13 PD=5.9400e-06
.ends
.subckt sh in out vdd gnd
mp out in vdd vdd CMOSP W=5.4000e-07 L=1.8000e-07 AS=2.9160e-13 PS=2.1600e-06 AD=2.9160e-13 PD=2.1600e-06
mn out in gnd gnd CMOSN W=2.7000e-07 L=1.8000e-07 AS=1.4580e-13 PS=1.6200e-06 AD=1.4580e-13 PD=1.6200e-06
.ends
.subckt dr in out vdd gnd
mp out in vdd vdd CMOSP W=7.8162e-07 L=1.8000e-07 AS=4.2207e-13 PS=2.6432e-06 AD=4.2207e-13 PD=2.6432e-06
mn out in gnd gnd CMOSN W=3.9081e-07 L=1.8000e-07 AS=2.1104e-13 PS=1.8616e-06 AD=2.1104e-13 PD=1.8616e-06
.ends
.subckt lo in out vdd gnd
mp out in vdd vdd CMOSP W=1.8759e-05 L=1.8000e-07 AS=1.0130e-11 PS=3.8598e-05 AD=1.0130e-11 PD=3.8598e-05
mn out in gnd gnd CMOSN W=9.3794e-06 L=1.8000e-07 AS=5.0649e-12 PS=1.9839e-05 AD=5.0649e-12 PD=1.9839e-05
.ends
.subckt ll in out vdd gnd
mp out in vdd vdd CMOSP W=7.5035e-05 L=1.8000e-07 AS=4.0519e-11 PS=1.5115e-04 AD=4.0519e-11 PD=1.5115e-04
mn out in gnd gnd CMOSN W=3.7518e-05 L=1.8000e-07 AS=2.0259e-11 PS=7.6115e-05 AD=2.0259e-11 PD=7.6115e-05
.ends
X0 in0 n1 vdd gnd sh
X1 n1 ndut vdd gnd dr
X2 vdd vdd ndut nout vdd gnd gnand3
X3 nout n3 vdd gnd lo
X4 n3 n4 vdd gnd ll
.tran 0.5p 11n
.meas tran tphl TRIG v(ndut) VAL=0.9 RISE=2 TARG v(nout) VAL=0.9 FALL=2
.meas tran tplh TRIG v(ndut) VAL=0.9 FALL=2 TARG v(nout) VAL=0.9 RISE=2
.end
